# Copy to `.env` and fill in real values. Never commit `.env`.

# --- PostgreSQL (shared by docker-compose.yml and the app) ---
POSTGRES_USER=cartpilot
POSTGRES_PASSWORD=cartpilot
POSTGRES_DB=cartpilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional (project-prefixed to avoid clashing with a global DATABASE_URL): full override of the async SQLAlchemy URL (otherwise built from the vars above)
# CARTPILOT_DATABASE_URL=postgresql+asyncpg://cartpilot:cartpilot@localhost:5432/cartpilot
DB_ECHO=false

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs that are auto-activated on /start
ADMIN_TELEGRAM_IDS=

# --- LLM (PydanticAI model strings: "<provider>:<model>") ---
GEMINI_API_KEY=
MODEL_FAST=google-gla:gemini-3.8-flash
MODEL_REASONING=google-gla:gemini-4-hydrogen
MODEL_EMBEDDING=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# Set to false in tests / offline development to skip embedding API calls
EMBEDDINGS_ENABLED=true

# --- Misc ---
LOG_LEVEL=INFO
